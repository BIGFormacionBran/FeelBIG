<Files ".env">
    Require all denied
</Files>

# Errores
ErrorDocument 400 /error/400
ErrorDocument 401 /error/401
ErrorDocument 403 /error/403
ErrorDocument 404 /error/404
ErrorDocument 500 /error/500

# --- Nueva lógica de rutas amigables ---
RewriteEngine On
RewriteBase /

# Evita que se aplique la regla si el archivo o carpeta existe físicamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirige todo a index.php pasando la ruta en la variable 'route'
RewriteRule ^(.*)$ index.php?route=$1 [L,QSA]